# PayU payment gateway — read by api/payu-hash.js and api/payu-response.js.
#
# Copy this file to .env.local (git-ignored) for local `vercel dev`, and set
# the same variables in Vercel → Project → Settings → Environment Variables
# for the Preview and Production environments.
#
# NEVER commit real values. The salt is a server secret and must never be
# imported into any src/ file or sent to the browser.

# Merchant key (PayU test credentials for now)
PAYU_KEY=

# Merchant salt / "Salt v1" — server-only secret
PAYU_SALT=

# "test" (default) uses https://test.payu.in/_payment
# "production" uses https://secure.payu.in/_payment
# Optional — omit it and the server defaults to test.
PAYU_ENV=test
