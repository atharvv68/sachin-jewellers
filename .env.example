# PayU payment gateway — required by api/payu-hash.js and api/payu-response.js
# Set the real values in Vercel → Project → Settings → Environment Variables.
# Do NOT commit real keys. Locally, copy this file to .env.local (git-ignored).

PAYU_KEY=
PAYU_SALT=

# "test" uses https://test.payu.in/_payment
# "production" uses https://secure.payu.in/_payment
PAYU_ENV=test
