    "inline:on-a-gemstone-pdp-choosing-a-carat-size-re-price-52c25eb9": {
      "id": "inline:on-a-gemstone-pdp-choosing-a-carat-size-re-price-52c25eb9",
      "statement": "On a gemstone PDP, choosing a carat size re-prices the product to that size's flat price and re-derives the discount: the now-price, the struck-through MRP, and the \"You save\" line must all reflect the selected size (10-11 ct zircon = ₹15,000 now, ₹30,000 MRP, save ₹15,000).",
      "state": "proved",
      "declaredAt": 1788426225622,
      "binding": {
        "kind": "allOf",
        "predicates": [
          {
            "kind": "text",
            "contains": "You save ₹15,000"
          },
          {
            "kind": "text",
            "contains": "₹30,000"
          }
        ]
      },
      "surface": {
        "route": "/stone/zircon",
        "files": [
          "src/pages/StonePage.jsx"
        ]
      },
      "provenBy": {
        "verdictId": "reticle_act_and_wait:1788426226135",
        "grade": "presence",
        "at": 1788426226135
      }
    },
    "flow:gemstone-discount-pricing": {
      "id": "flow:gemstone-discount-pricing",
      "statement": "On a gemstone PDP, selecting a carat size re-prices the product to that size's flat price and re-derives the discount (now-price, struck-through MRP, 'You save' line). 10-11 ct zircon must show ₹15,000 now / ₹30,000 MRP / You save ₹15,000.",
      "state": "declared",
      "declaredAt": 1788426253726,
      "surface": {
        "flow": "gemstone-discount-pricing"
      }
    },
    "inline:on-the-product-page-the-discount-badge-and-struc-f451b76a": {
      "id": "inline:on-the-product-page-the-discount-badge-and-struc-f451b76a",
      "statement": "On the product page, the discount badge and struck-through MRP are driven by the selected carat size, so switching colour preserves them and reflects the new colour in the URL",
      "state": "proved",
      "declaredAt": 1788426464667,
      "binding": {
